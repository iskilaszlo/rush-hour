<configuration>
    <!-- A naplók fájlba kerülnek, hogy ne zavarják a játék kiírásait a konzolon -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>rush-hour.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
